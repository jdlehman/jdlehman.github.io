# Local dev for unlisted (secret) apps — copy to .env.local and fill in your UUIDs.
# The UUID must match the hub secret (e.g. RECIPE_VIEWER_SLUG) and the private app's vite.config.ts base.
# Not committed — .env.local is gitignored.

# VITE_RECIPE_VIEWER_SLUG=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# VITE_OTHER_APP_SLUG=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
